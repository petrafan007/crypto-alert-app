[Unit]
Description=Crypto Dashboard Background Scheduler
After=network.target crypto-dashboard.service
Requires=crypto-dashboard.service
PartOf=crypto-dashboard.service

[Service]
Type=simple
User=jcavallarojr
Group=jcavallarojr
WorkingDirectory=/var/www/html/csdapp
Environment=PATH=/var/www/html/csdapp/venv/bin
ExecStart=/var/www/html/csdapp/venv/bin/python3 runtime.py worker
Restart=always
RestartSec=10
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
