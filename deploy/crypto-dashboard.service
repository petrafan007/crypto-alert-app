[Unit]
Description=Crypto Dashboard Web
After=network.target
Wants=network.target crypto-dashboard-worker.service

[Service]
Type=simple
User=jcavallarojr
Group=jcavallarojr
WorkingDirectory=/var/www/html/csdapp
Environment=PATH=/var/www/html/csdapp/venv/bin
ExecStartPre=/var/www/html/csdapp/venv/bin/python3 runtime.py init-db
ExecStart=/var/www/html/csdapp/venv/bin/gunicorn --bind 0.0.0.0:5010 --workers 2 --worker-class gthread --threads 4 --timeout 180 --access-logfile - --error-logfile - main:app
Restart=always
RestartSec=10
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
