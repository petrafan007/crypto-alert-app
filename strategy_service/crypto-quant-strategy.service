[Unit]
Description=Credential-free quantitative paper strategy service
After=network.target

[Service]
Type=simple
User=crypto-quant
Group=jcavallarojr
RuntimeDirectory=crypto-quant-strategy
RuntimeDirectoryMode=0770
StateDirectory=crypto-quant-strategy
StateDirectoryMode=0750
Environment=QUANT_STRATEGY_ROOT=/var/lib/crypto-quant-strategy
Environment=QUANT_STRATEGY_SOCKET=/run/crypto-quant-strategy/strategy.sock
ExecStart=/usr/bin/python3 -I /opt/crypto-quant-strategy/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/crypto-quant-strategy /run/crypto-quant-strategy
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
LockPersonality=true
MemoryMax=384M
TasksMax=32

[Install]
WantedBy=multi-user.target
